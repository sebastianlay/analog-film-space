<IfModule mod_rewrite.c>

  RewriteEngine On

  # non-https to https and www to non-www redirect
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [NE,R=301]

</IfModule>

<IfModule mod_headers.c>

  # hashed assets: immutable, 1 year cache
  # matches both Vite assets (name.hash.ext) and Astro font files (hash.woff2)
  <filesMatch "^.+\.[a-zA-Z0-9_-]{8,}\..+$|^[a-f0-9]{16}\.woff2$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </filesMatch>

  # HTML: no cache (references hashed asset URLs)
  <filesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </filesMatch>

  # webmanifest: short cache
  <filesMatch "\.webmanifest$">
    Header set Cache-Control "max-age=86400, public"
  </filesMatch>

  # security headers
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

</IfModule>

# MIME types
AddType application/manifest+json .webmanifest
